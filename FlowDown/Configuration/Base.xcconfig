#include "Version.xcconfig"

DEVELOPMENT_TEAM = 964G86XT2P;
PRODUCT_BUNDLE_IDENTIFIER = wiki.qaq.flow;

CLOUDKIT_SYNC_CONTAINER_IDENTIFIER = iCloud.$(PRODUCT_BUNDLE_IDENTIFIER).sync;

CODE_SIGN_STYLE = Automatic;
CODE_SIGN_IDENTITY = Apple Development;
CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development;
PROVISIONING_PROFILE_SPECIFIER =;
CODE_SIGNING_ALLOWED = YES;
CODE_SIGNING_REQUIRED = YES;
CODE_SIGNING_SUPPORTED = YES;

SUPPORTED_PLATFORMS = iphoneos iphonesimulator;
SUPPORTED_PLATFORMS[sdk=macosx*] = macosx;
SUPPORTS_MACCATALYST = NO;
SUPPORTS_MACCATALYST[sdk=macosx*] = YES;
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO;
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO;

// Defined when the SDK declares UIView.reservedRegions(kind:options:) and
// UIHingeInteraction (iOS 27.1). The SDKs listed below predate them; every
// other SDK, including later ones, gets the condition. Mac Catalyst never does.
FLOWDOWN_RESERVED_REGIONS_CONDITION = FLOWDOWN_HAS_RESERVED_REGIONS
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphoneos27.0*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphonesimulator27.0*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphoneos26*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphonesimulator26*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphoneos1*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=iphonesimulator1*] =
FLOWDOWN_RESERVED_REGIONS_CONDITION[sdk=macosx*] =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(FLOWDOWN_RESERVED_REGIONS_CONDITION)
